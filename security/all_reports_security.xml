<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_all_reports" model="ir.module.category">
        <field name="name">All Reports</field>
        <field name="description">Access rights for All Reports module</field>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_all_reports" model="res.groups.privilege">
        <field name="name">All Reports</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_all_reports"/>
    </record>

    <record id="group_all_reports_user" model="res.groups">
        <field name="name">User: View All Reports</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_all_reports"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_all_reports_manager" model="res.groups">
        <field name="name">Manager: Full Reports Access</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_all_reports"/>
        <field name="implied_ids" eval="[Command.link(ref('all_reports.group_all_reports_user'))]"/>
    </record>
</odoo>