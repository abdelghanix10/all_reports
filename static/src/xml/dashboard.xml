<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="all_reports.Dashboard">
        <div class="o_all_reports_dashboard h-100 d-flex flex-column overflow-auto">
            <!-- Header & Filters -->
            <div class="p-3 bg-white border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <h3 class="m-0 fw-bold">All Reports</h3>
                    <!-- Quick Date Presets -->
                    <div class="btn-group btn-group-sm o_all_reports_no_print" role="group">
                        <button type="button" class="btn btn-outline-primary" t-att-class="{active: this.state.datePreset === 'today'}" t-on-click="() => this.setDatePreset('today')">Today</button>
                        <button type="button" class="btn btn-outline-primary" t-att-class="{active: this.state.datePreset === 'yesterday'}" t-on-click="() => this.setDatePreset('yesterday')">Yesterday</button>
                        <button type="button" class="btn btn-outline-primary" t-att-class="{active: this.state.datePreset === 'this_week'}" t-on-click="() => this.setDatePreset('this_week')">This Week</button>
                        <button type="button" class="btn btn-outline-primary" t-att-class="{active: this.state.datePreset === 'this_month'}" t-on-click="() => this.setDatePreset('this_month')">This Month</button>
                    </div>
                </div>

                <!-- Filter Controls -->
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <!-- Search Input -->
                    <div class="input-group input-group-sm o_all_reports_no_print" style="width: 200px;">
                        <span class="input-group-text bg-light"><i class="fa fa-search"/></span>
                        <input type="text" class="form-control" placeholder="Search product / session..." t-att-value="this.state.searchQuery" t-on-input="(ev) => this.onSearchInput(ev)"/>
                    </div>

                    <!-- POS Terminal Filter -->
                    <select class="form-select form-select-sm o_all_reports_no_print" style="width: auto;" t-on-change="(ev) => this.onPosConfigChange(ev)">
                        <option value="">All POS Terminals</option>
                        <t t-foreach="this.state.data.pos_configs" t-as="cfg" t-key="cfg.id">
                            <option t-att-value="cfg.id" t-att-selected="this.state.selectedPosConfig == cfg.id">
                                <t t-out="cfg.name"/>
                            </option>
                        </t>
                    </select>

                    <!-- Date Range Pickers -->
                    <div class="d-flex align-items-center">
                        <label class="me-1 small fw-bold">From:</label>
                        <input type="date" class="form-control form-control-sm" t-att-value="this.state.startDate" t-on-change="(ev) => this.onStartDateChange(ev)"/>
                    </div>
                    <div class="d-flex align-items-center">
                        <label class="me-1 small fw-bold">To:</label>
                        <input type="date" class="form-control form-control-sm" t-att-value="this.state.endDate" t-on-change="(ev) => this.onEndDateChange(ev)"/>
                    </div>

                    <!-- Actions: Refresh, Export CSV, Print -->
                    <div class="btn-group btn-group-sm o_all_reports_no_print">
                        <button class="btn btn-outline-secondary" title="Refresh" t-on-click="() => this.fetchData()">
                            <i class="fa fa-refresh"/>
                        </button>
                        <button class="btn btn-outline-success" title="Export CSV" t-on-click="() => this.exportCSV()">
                            <i class="fa fa-download me-1"/>CSV
                        </button>
                        <button class="btn btn-outline-dark" title="Print Report" t-on-click="() => this.printReport()">
                            <i class="fa fa-print"/>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Navigation Tabs -->
            <div class="bg-white border-bottom o_all_reports_no_print">
                <ul class="nav nav-tabs px-3 pt-2">
                    <li class="nav-item">
                        <a class="nav-link" t-att-class="{active: this.state.activeTab === 'dashboard'}" href="#" t-on-click.prevent="() => this.setTab('dashboard')">
                            <i class="fa fa-tachometer me-1"/>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" t-att-class="{active: this.state.activeTab === 'sessions'}" href="#" t-on-click.prevent="() => this.setTab('sessions')">
                            <i class="fa fa-desktop me-1"/>Sessions (<t t-out="this.filteredSessions.length"/>)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" t-att-class="{active: this.state.activeTab === 'top_products'}" href="#" t-on-click.prevent="() => this.setTab('top_products')">
                            <i class="fa fa-star me-1"/>Top Products (<t t-out="this.filteredTopProducts.length"/>)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" t-att-class="{active: this.state.activeTab === 'production'}" href="#" t-on-click.prevent="() => this.setTab('production')">
                            <i class="fa fa-industry me-1"/>Production (<t t-out="this.filteredProduction.length"/>)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" t-att-class="{active: this.state.activeTab === 'lost_products'}" href="#" t-on-click.prevent="() => this.setTab('lost_products')">
                            <i class="fa fa-exclamation-triangle me-1"/>Lost &amp; Discrepancies
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Main Content -->
            <div class="flex-grow-1 p-3">
                <t t-if="this.state.loading">
                    <div class="d-flex justify-content-center align-items-center h-100 py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <!-- KPI Cards Row (Always visible on Dashboard tab) -->
                    <t t-if="this.state.activeTab === 'dashboard'">
                        <t t-call="all_reports.KpiRow"/>
                    </t>

                    <div t-if="this.state.activeTab === 'dashboard'" class="d-flex flex-column gap-4">
                        <t t-call="all_reports.SessionsTable"/>
                        <div class="row g-4">
                            <div class="col-lg-6">
                                <t t-call="all_reports.TopProductsTable"/>
                            </div>
                            <div class="col-lg-6">
                                <t t-call="all_reports.ProductionTable"/>
                            </div>
                        </div>
                        <t t-call="all_reports.LostProductsTable"/>
                    </div>

                    <div t-if="this.state.activeTab === 'sessions'">
                        <t t-call="all_reports.SessionsTable"/>
                    </div>
                    <div t-if="this.state.activeTab === 'top_products'">
                        <t t-call="all_reports.TopProductsTable"/>
                    </div>
                    <div t-if="this.state.activeTab === 'production'">
                        <t t-call="all_reports.ProductionTable"/>
                    </div>
                    <div t-if="this.state.activeTab === 'lost_products'">
                        <t t-call="all_reports.LostProductsTable"/>
                    </div>
                </t>
            </div>
        </div>
    </t>

    <!-- KPI Cards Template -->
    <t t-name="all_reports.KpiRow">
        <div class="row g-3 mb-4">
            <!-- Total Sales Card -->
            <div class="col-md-6 col-xl-3">
                <div class="card o_kpi_card kpi-sales h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase fw-bold">Total POS Sales (Incl. Tax)</div>
                        <h3 class="fw-bold text-success my-1" t-out="this.formatCurrency(this.state.data.kpis.total_sales)"/>
                        <div class="small text-muted d-flex justify-content-between">
                            <span>Net: <strong t-out="this.formatCurrency(this.state.data.kpis.net_sales)"/></span>
                            <span>Tax: <strong t-out="this.formatCurrency(this.state.data.kpis.total_tax)"/></span>
                        </div>
                        <div class="small text-muted d-flex justify-content-between mt-1">
                            <span>Discounts: <strong t-out="this.formatCurrency(this.state.data.kpis.total_discount)"/></span>
                            <span class="text-danger">Returns: <strong t-out="this.formatCurrency(this.state.data.kpis.total_returns)"/></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sessions & Orders Card -->
            <div class="col-md-6 col-xl-3">
                <div class="card o_kpi_card kpi-orders h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase fw-bold">Orders &amp; Sessions</div>
                        <h3 class="fw-bold text-primary my-1">
                            <t t-out="this.state.data.kpis.total_orders"/> Orders
                            <span class="fs-6 text-muted fw-normal">in <t t-out="this.state.data.kpis.total_sessions"/> sessions</span>
                        </h3>
                        <div class="small text-muted">
                            Avg. Basket: <strong t-out="this.formatCurrency(this.state.data.kpis.avg_order_value)"/>
                        </div>
                        <div class="small mt-1">
                            Cash Diff:
                            <strong t-att-class="this.state.data.kpis.total_cash_diff &lt; 0 ? 'text-danger' : 'text-success'" t-out="this.formatCurrency(this.state.data.kpis.total_cash_diff)"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Production Card -->
            <div class="col-md-6 col-xl-3">
                <div class="card o_kpi_card kpi-production h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase fw-bold">Total Manufactured</div>
                        <h3 class="fw-bold text-info my-1">
                            <t t-out="this.formatNumber(this.state.data.kpis.total_produced_qty)"/> Units
                        </h3>
                        <div class="small text-muted">
                            Distinct Products: <strong t-out="this.state.data.production.length"/>
                        </div>
                        <div class="small text-muted mt-1" t-if="this.state.data.payment_summary.length > 0">
                            Top Payment: <strong t-out="this.state.data.payment_summary[0].name"/> (<t t-out="this.formatCurrency(this.state.data.payment_summary[0].amount)"/>)
                        </div>
                    </div>
                </div>
            </div>

            <!-- Inventory Loss Card -->
            <div class="col-md-6 col-xl-3">
                <div class="card o_kpi_card kpi-loss h-100">
                    <div class="card-body">
                        <div class="text-muted small text-uppercase fw-bold">Inventory Loss (Retail Value)</div>
                        <h3 class="fw-bold text-danger my-1" t-out="this.formatCurrency(this.state.data.kpis.total_lost_value)"/>
                        <div class="small text-muted">
                            Cost Value: <strong t-out="this.formatCurrency(this.state.data.kpis.total_lost_cost)"/>
                        </div>
                        <div class="small text-muted mt-1">
                            Lost Quantity: <strong t-out="this.formatNumber(this.state.data.kpis.total_lost_qty)"/> Units
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- POS Sessions Table -->
    <t t-name="all_reports.SessionsTable">
        <div class="card">
            <div class="card-header fw-bold d-flex justify-content-between align-items-center bg-white">
                <span>POS Sessions</span>
                <div class="d-flex gap-2 align-items-center o_all_reports_no_print" t-if="this.filteredSessions.length > 0">
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.prevPage()" t-att-disabled="this.state.sessionsPage === 1">Previous</button>
                    <span class="small">Page <t t-out="this.state.sessionsPage"/> of <t t-out="this.totalSessionPages"/></span>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.nextPage()" t-att-disabled="this.state.sessionsPage === this.totalSessionPages">Next</button>
                </div>
            </div>
            <div class="card-body p-0">
                <t t-foreach="this.paginatedSessions" t-as="session" t-key="session.id">
                    <div class="border-bottom p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <h5 class="m-0" t-out="session.name"/>
                                <button class="btn btn-sm btn-link p-0 o_all_reports_no_print" title="Open Session in Odoo" t-on-click="() => this.openSessionForm(session.id)">
                                    <i class="fa fa-external-link"/>
                                </button>
                            </div>
                            <span t-att-class="'badge ' + (session.status === 'opened' ? 'bg-success' : 'bg-secondary')" t-out="session.status"/>
                        </div>
                        <div class="row g-2 mb-2 small">
                            <div class="col-md-3"><strong>Opened:</strong> <span t-out="session.opened_date"/></div>
                            <div class="col-md-3"><strong>Closed:</strong> <span t-out="session.closed_date"/></div>
                            <div class="col-md-3"><strong>Orders:</strong> <span t-out="session.order_count"/></div>
                            <div class="col-md-3"><strong>Total Sales:</strong> <span class="fw-bold text-success" t-out="this.formatCurrency(session.total)"/></div>
                        </div>
                        <div class="row g-2 mb-2 small">
                            <div class="col-md-3"><strong>Opening Cash:</strong> <span t-out="this.formatCurrency(session.opening_balance)"/></div>
                            <div class="col-md-3"><strong>Closing Cash:</strong> <span t-out="this.formatCurrency(session.closing_balance)"/></div>
                            <div class="col-md-3">
                                <strong>Difference:</strong>
                                <span t-att-class="session.difference &lt; 0 ? 'text-danger fw-bold' : 'text-success'" t-out="this.formatCurrency(session.difference)"/>
                            </div>
                            <div class="col-md-3">
                                <strong>Discounts / Returns:</strong>
                                <span t-out="this.formatCurrency(session.discount)"/> / <span class="text-danger" t-out="this.formatCurrency(session.returns)"/>
                            </div>
                        </div>

                        <!-- Payment Methods Pills -->
                        <div class="d-flex flex-wrap gap-2 mt-2" t-if="session.payments.length > 0">
                            <t t-foreach="session.payments" t-as="pm" t-key="pm.name">
                                <span class="badge bg-light text-dark border">
                                    <t t-out="pm.name"/>: <strong t-out="this.formatCurrency(pm.amount)"/>
                                </span>
                            </t>
                        </div>

                        <!-- Breakdown Accordion -->
                        <div class="mt-3">
                            <button class="btn btn-light btn-sm w-100 d-flex justify-content-between align-items-center border" t-on-click="() => this.toggleSession(session.id)">
                                <span class="fw-bold">Sales Breakdown by Category</span>
                                <i class="fa" t-att-class="this.state.expandedSessions[session.id] ? 'fa-chevron-up' : 'fa-chevron-down'"/>
                            </button>
                            <div t-if="this.state.expandedSessions[session.id]" class="border border-top-0 p-3 bg-white">
                                <t t-foreach="session.breakdown" t-as="cat" t-key="cat.name">
                                    <div class="mb-3 p-2 border rounded bg-light">
                                        <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-1">
                                            <span class="fw-bold text-primary" t-out="cat.name"/>
                                            <span class="fw-bold" t-out="this.formatCurrency(cat.total)"/>
                                        </div>
                                        <table class="table table-sm table-hover mb-0 bg-white">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Product</th>
                                                    <th class="text-end">Qty</th>
                                                    <th class="text-end">Amount</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="cat.products" t-as="prod" t-key="prod.name">
                                                    <td t-out="prod.name"/>
                                                    <td class="text-end" t-out="this.formatNumber(prod.qty)"/>
                                                    <td class="text-end" t-out="this.formatCurrency(prod.amount)"/>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </t>
                                <t t-if="session.breakdown.length === 0">
                                    <div class="text-muted text-center">No sales in this session.</div>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-if="this.filteredSessions.length === 0">
                    <div class="p-4 text-center text-muted">No POS sessions found for the selected criteria.</div>
                </t>
            </div>
        </div>
    </t>

    <!-- Top Selling Products Table -->
    <t t-name="all_reports.TopProductsTable">
        <div class="card h-100">
            <div class="card-header fw-bold bg-white">Top Selling Products</div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th class="text-end">Qty Sold</th>
                            <th class="text-end">Revenue</th>
                            <th class="text-end" style="width: 120px;">Share</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="this.filteredTopProducts" t-as="prod" t-key="prod.product_name">
                            <td t-out="prod.product_name"/>
                            <td><span class="badge bg-light text-dark border" t-out="prod.category"/></td>
                            <td class="text-end" t-out="this.formatNumber(prod.qty)"/>
                            <td class="text-end fw-bold" t-out="this.formatCurrency(prod.amount)"/>
                            <td class="text-end">
                                <div class="d-flex align-items-center justify-content-end gap-1">
                                    <small t-out="prod.share + '%'"/>
                                    <div class="progress flex-grow-1" style="height: 6px; max-width: 50px;">
                                        <div class="progress-bar bg-success" role="progressbar" t-att-style="'width: ' + prod.share + '%'"/>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr t-if="this.filteredTopProducts.length === 0">
                            <td colspan="5" class="text-center text-muted p-4">No product sales found.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>

    <!-- Production Table -->
    <t t-name="all_reports.ProductionTable">
        <div class="card h-100">
            <div class="card-header fw-bold bg-white">Manufacturing / Production</div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Quantity Produced</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="this.filteredProduction" t-as="move" t-key="move.product_name">
                            <td t-out="move.product_name"/>
                            <td class="text-end fw-bold" t-out="this.formatNumber(move.quantity)"/>
                            <td><span class="badge bg-success" t-out="move.status"/></td>
                        </tr>
                        <tr t-if="this.filteredProduction.length === 0">
                            <td colspan="3" class="text-center text-muted p-4">No production records found.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>

    <!-- Lost Products & Production vs Sales Table -->
    <t t-name="all_reports.LostProductsTable">
        <div class="d-flex flex-column gap-4">
            <!-- Production vs Sales Comparison -->
            <div class="card">
                <div class="card-header fw-bold bg-white">Production vs Sales Comparison (Including BOM Components)</div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-end">Quantity Produced</th>
                                <th class="text-end">Quantity Sold / Consumed</th>
                                <th class="text-end">Difference (Produced - Sold)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="this.filteredProductionVsSales" t-as="row" t-key="row.product_name">
                                <td t-out="row.product_name"/>
                                <td class="text-end" t-out="this.formatNumber(row.produced_qty)"/>
                                <td class="text-end" t-out="this.formatNumber(row.sales_qty)"/>
                                <td class="text-end fw-bold" t-att-class="row.difference &lt; 0 ? 'text-danger' : 'text-success'" t-out="this.formatNumber(row.difference)"/>
                            </tr>
                            <tr t-if="this.filteredProductionVsSales.length === 0">
                                <td colspan="4" class="text-center text-muted p-4">No production records found for comparison.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Lost Products Table -->
            <div class="card">
                <div class="card-header fw-bold bg-white">Lost &amp; Adjusted Products</div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Location</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Cost Value</th>
                                <th class="text-end">Retail Value (Qty * Sale Price)</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="this.filteredLostProducts" t-as="move" t-key="move.product_name">
                                <td t-out="move.product_name"/>
                                <td class="text-muted small" t-out="move.location"/>
                                <td class="text-end fw-bold" t-out="this.formatNumber(move.quantity)"/>
                                <td class="text-end" t-out="this.formatCurrency(move.cost_value)"/>
                                <td class="text-end fw-bold text-danger" t-out="this.formatCurrency(move.total_value)"/>
                                <td><span class="badge bg-secondary" t-out="move.status"/></td>
                            </tr>
                            <tr t-if="this.filteredLostProducts.length === 0">
                                <td colspan="6" class="text-center text-muted p-4">No lost products found.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>